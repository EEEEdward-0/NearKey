<Window x:Class="BluetoothUnlock.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="靠近解锁设置" Width="1120" Height="800" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F5F7FA" Foreground="#243247" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderBrush" Value="#E4E9F0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B778A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2374CF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EAF1FA" />
            <Setter Property="Foreground" Value="#2867AC" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#556479" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E9F0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="DeviceTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeviceDetail}" TextWrapping="Wrap" Foreground="#748095" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding SignalText}" Foreground="#2374CF" TextAlignment="Right" />
                    <TextBlock Text="{Binding IdentityText}" Foreground="#748095" FontSize="11" TextAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="#F5F7FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="185" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="#E4E9F0" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,28">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,32">
                    <TextBlock Text="靠近解锁" FontSize="22" FontWeight="Bold" Foreground="#2374CF" />
                    <TextBlock Text="Bluetooth Unlock" Foreground="#8793A4" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="关闭窗口后，后台继续运行。" Foreground="#8793A4" FontSize="11" Margin="8,20,8,0" />
                <StackPanel>
                    <Button x:Name="DevicesNav" Content="设备" Tag="Devices" Click="OnNavigate" Style="{StaticResource NavButton}" Background="#EAF1FA" />
                    <Button x:Name="RulesNav" Content="解锁设置" Tag="Rules" Click="OnNavigate" Style="{StaticResource NavButton}" />
                    <Button x:Name="EventsNav" Content="运行记录" Tag="Events" Click="OnNavigate" Style="{StaticResource NavButton}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,24,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="设备" FontSize="26" FontWeight="Bold" />
                    <TextBlock x:Name="PageSubtitle" Text="选择用于靠近解锁的手机" Foreground="#748095" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#E8F4EE" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="正在读取状态" Foreground="#23805C" />
                </Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="已选设备平均信号" Foreground="#748095" FontSize="11" />
                        <TextBlock x:Name="MeanText" Text="-- dBm" FontSize="22" FontWeight="SemiBold" Foreground="#2374CF" />
                        <TextBlock x:Name="DeviceCountText" Text="等待设备" Foreground="#748095" FontSize="11" />
                    </StackPanel>
                    <TextBlock x:Name="BluetoothStateText" Grid.Column="1" Text="蓝牙：等待状态" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock x:Name="LanStateText" Grid.Column="2" Text="局域网：等待状态" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid x:Name="DevicesPage" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#EAF1FA" CornerRadius="9" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="首次使用" FontWeight="SemiBold" />
                        <TextBlock Text="1. 在 Windows 蓝牙设置中配对手机，并保持手机蓝牙开启。&#xA;2. 在下方选中收到实时信号的手机，点击添加。&#xA;3. 前往解锁设置，保存规则后再测试锁屏。" Foreground="#556479" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="可添加的设备" Style="{StaticResource Heading}" />
                            <TextBlock Grid.Row="1" Text="已配对设备优先显示；有实时信号时可添加。" Style="{StaticResource Help}" />
                            <ListBox x:Name="NearbyList" Grid.Row="2" ItemTemplate="{StaticResource DeviceTemplate}" />
                            <Button Grid.Row="3" Content="添加选中设备" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnAddDevice" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="用于解锁的设备" Style="{StaticResource Heading}" />
                            <TextBlock x:Name="SavedDevicesText" Grid.Row="1" Text="尚未添加设备" Style="{StaticResource Help}" />
                            <ListBox x:Name="SelectedList" Grid.Row="2" ItemTemplate="{StaticResource DeviceTemplate}" />
                            <Button Grid.Row="3" Content="移除选中设备" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnRemoveDevice" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="RulesPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="解锁方式" Style="{StaticResource Heading}" />
                                <CheckBox x:Name="AutoUnlockCheck" Content="启用靠近解锁" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="确认按键" VerticalAlignment="Center" />
                                    <TextBox x:Name="UnlockKeyBox" Grid.Column="1" Width="180" HorizontalAlignment="Left" />
                                </Grid>
                                <TextBlock Text="输入 Enter 或单个英文字母，留空使用 Enter。手机靠近后，在 PIN 登录界面按此键确认。" Style="{StaticResource Help}" />
                                <TextBlock Text="满足什么条件时允许解锁" FontWeight="SemiBold" Margin="0,4,0,10" />
                                <RadioButton x:Name="BluetoothMode" Content="仅蓝牙靠近" GroupName="Mode" IsChecked="True" Checked="OnModeChanged" Margin="0,0,0,10" />
                                <RadioButton x:Name="LanMode" Content="仅局域网设备全部在线" GroupName="Mode" Checked="OnModeChanged" Margin="0,0,0,10" />
                                <RadioButton x:Name="BothMode" Content="蓝牙靠近，并且局域网设备全部在线" GroupName="Mode" Checked="OnModeChanged" />
                                <StackPanel x:Name="LanFields" Margin="0,16,0,0" Visibility="Collapsed">
                                    <TextBlock Text="局域网设备信息" FontWeight="SemiBold" />
                                    <TextBlock Text="可以扫描局域网后选择设备，无需手动输入；也可以手动填写 IP 和 Wi-Fi MAC，或填写其中一项后补全。扫描结果包含路由器等其他设备，请确认选择的是自己的手机。" Style="{StaticResource Help}" />
                                    <Button x:Name="ScanLanButton" Content="扫描局域网设备" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Click="OnScanLan" />
                                    <StackPanel x:Name="LanScanPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                        <TextBlock x:Name="LanScanHint" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <ListBox x:Name="LanScanList" Height="140" DisplayMemberPath="Display" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="填入设备 1" Tag="1" Style="{StaticResource SecondaryButton}" Click="OnUseLanScan" Margin="0,0,12,0" />
                                            <Button Content="填入设备 2" Tag="2" Style="{StaticResource SecondaryButton}" Click="OnUseLanScan" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="设备 1" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="IPv4 地址" Margin="0,0,0,6" />
                                            <TextBox x:Name="LanIpBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Wi-Fi MAC 地址" Margin="0,0,0,6" />
                                            <TextBox x:Name="LanMacBox" />
                                        </StackPanel>
                                    </Grid>
                                    <Button x:Name="ResolveLanButton" Content="根据已填信息补全" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnResolveLan" />
                                    <TextBlock Text="设备 2（可选）" FontWeight="SemiBold" Margin="0,16,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="IPv4 地址" Margin="0,0,0,6" />
                                            <TextBox x:Name="LanIpBox2" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Wi-Fi MAC 地址" Margin="0,0,0,6" />
                                            <TextBox x:Name="LanMacBox2" />
                                        </StackPanel>
                                    </Grid>
                                    <Button x:Name="ResolveLanButton2" Content="根据已填信息补全第二台" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnResolveLan" />
                                    <TextBlock Text="配置一台时，该设备在线即通过；配置两台时，两台都在线才通过。删除第二台的两项信息并保存可恢复单台。" Style="{StaticResource Help}" />
                                    <TextBlock Text="补全后请确认这是你的手机，再保存设置。手机需与电脑在同一局域网；局域网只能确认设备在线，不能判断距离。" Style="{StaticResource Help}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="距离与自动锁定" Style="{StaticResource Heading}" />
                                <TextBlock Text="平均信号解锁阈值" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="UnlockSlider" Minimum="-100" Maximum="-20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,16,0" />
                                    <TextBlock x:Name="UnlockValue" Grid.Column="1" VerticalAlignment="Center" Foreground="#2374CF" />
                                </Grid>
                                <TextBlock Text="对最近 20 秒收到广播的已选设备取平均，平均值达到此阈值才满足蓝牙解锁条件。未检测到的设备不参与计算；数值越接近 0，要求越近。调整后需保存设置。" Style="{StaticResource Help}" />
                                <CheckBox x:Name="AutoLockCheck" Content="离开后自动锁定" />
                                <TextBlock Text="平均信号锁定阈值" Margin="0,6,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="LockSlider" Minimum="-100" Maximum="-20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,16,0" />
                                    <TextBlock x:Name="LockValue" Grid.Column="1" Foreground="#2374CF" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="锁定阈值应低于或等于解锁阈值，减少信号波动导致的反复锁定。" Style="{StaticResource Help}" />
                                <TextBlock Text="持续离开多久后锁定" Margin="0,0,0,6" />
                                <ComboBox x:Name="DelayBox" Height="36" Width="180" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="30 秒" Tag="30" />
                                    <ComboBoxItem Content="60 秒" Tag="60" />
                                    <ComboBoxItem Content="120 秒" Tag="120" />
                                    <ComboBoxItem Content="300 秒" Tag="300" />
                                </ComboBox>
                                <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动后台" Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#EAF1FA" CornerRadius="9" Padding="16">
                            <TextBlock Text="测试步骤：保存设置 → 手机放在电脑旁 → 按 Win+L 锁屏 → 进入 PIN 登录界面 → 按确认键。仍可使用原有 PIN 或密码登录。" Foreground="#556479" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="1" Content="保存设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="OnSaveSettings" />
            </Grid>
            <Border x:Name="EventsPage" Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="后台运行记录" Style="{StaticResource Heading}" />
                        <Button Content="立即锁定" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="OnManualLock" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="最近的启动、进入范围、离开范围和自动锁定事件。" Style="{StaticResource Help}" />
                    <ListBox x:Name="EventList" Grid.Row="2" FontSize="12" />
                </Grid>
            </Border>
            <TextBlock x:Name="HintText" Grid.Row="3" Text="先添加手机，再前往解锁设置保存规则。" Foreground="#6B778A" Margin="0,14,0,0" />
        </Grid>
    </Grid>
</Window>
