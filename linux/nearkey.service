[Unit]
Description=NearKey proximity authentication and lock monitor
After=bluetooth.service systemd-logind.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/nearkey run
Restart=on-failure
RestartSec=5
RuntimeDirectory=nearkey
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
